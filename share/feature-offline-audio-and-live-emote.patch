+  /// 把自建文件夹里的条目从原分组摘出来，作为一个「文件夹」分组插到最前面
+  void _applyFolders(List<DownloadSeasonInfo> list) {
+    final folders = DownloadFolderStore.folders;
+    if (folders.isEmpty) return;
+    final folderIds = {for (final folder in folders) folder.id};
+    final buckets = <int, List<BiliDownloadEntryInfo>>{};
+
+    for (final season in list) {
+      for (final page in season.pages) {
+        page.entries.removeWhere((entry) {
+          final folderId = DownloadFolderStore.folderOf(entry.cid);
+          if (folderId == null || !folderIds.contains(folderId)) return false;
+          buckets
+              .putIfAbsent(folderId, () => <BiliDownloadEntryInfo>[])
+              .add(entry);
+          return true;
+        });
+      }
+      season.pages.removeWhere((page) => page.entries.isEmpty);
+    }
+    list.removeWhere((season) => season.pages.isEmpty);
+
+    final folderSeasons = <DownloadSeasonInfo>[];
+    for (final folder in folders) {
+      final entries = buckets[folder.id];
+      if (entries == null || entries.isEmpty) continue;
+      entries.sort((a, b) => a.sortKey.compareTo(b.sortKey));
+      folderSeasons.add(
+        DownloadSeasonInfo(
+          seasonInfo: SeasonInfo(
+            index: 0,
+            id: folder.id,
+            title: folder.name,
+            cover: entries.first.cover,
+            mid: 0,
+            uname: '本地文件夹',
+          ),
+          pageId: 'folder-${folder.id}',
+          isFolder: true,
+          pages: entries.map((e) => e.toDownloadPageInfo(e.pageId)).toList(),
+        ),
+      );
+    }
+    if (folderSeasons.isNotEmpty) {
+      list.insertAll(0, folderSeasons);
+    }
+  }
