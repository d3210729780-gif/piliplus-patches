+  /// 否则栅格化时拿不到图只能退化画文字。
+  static Future<void> preloadEmotes(
+    Iterable<DanmakuEmote> emotes, {
+    Map<String, String>? headers,
+  }) async {
+    final pending = <String>{};
+    for (final emote in emotes) {
