+    if (emotes == null || emotes.isEmpty || text.isEmpty) {
+      return [(text: text, emote: null)];
+    }
+    final keys = emotes.keys
+        .where((key) => key.isNotEmpty && text.contains(key))
+        .toList()
+      ..sort((a, b) => b.length.compareTo(a.length));
+    if (keys.isEmpty) return [(text: text, emote: null)];
