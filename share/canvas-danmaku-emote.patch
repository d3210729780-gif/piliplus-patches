+    var index = 0;
+    while (index < text.length) {
+      var matchStart = -1;
+      String? matchKey;
+      for (final key in keys) {
+        final position = text.indexOf(key, index);
+        if (position != -1 && (matchStart == -1 || position < matchStart)) {
+          matchStart = position;
+          matchKey = key;
+        }
+      }
+      if (matchKey == null) {
+        segments.add((text: text.substring(index), emote: null));
+        break;
+      }
+      if (matchStart > index) {
