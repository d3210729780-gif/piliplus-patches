+import 'package:material_ui/material_ui.dart';
+
+/// 收藏夹多选批量下载：把选中的视频（含分P）一起丢进离线缓存队列。
+///
+/// 之前只能一个一个点进视频详情页再从菜单里下载，收藏夹里几十个视频非常麻烦。
+Future<void> batchDownloadFavVideos(
+  BuildContext context,
+  Iterable<FavDetailItemModel> items,
+) async {
+  // 只有 type == 2 是普通视频；音频/番剧等条目这里先跳过
+  final videos = items
+      .where((e) => e.type == 2 && (e.bvid?.isNotEmpty ?? false))
+      .toList();
+  final skipped = items.length - videos.length;
+  if (videos.isEmpty) {
+    SmartDialog.showToast('选中的条目里没有可下载的视频');
+    return;
+  }
+
+  final quality = await _pickQuality(context, videos.length);
+  if (quality == null) return;
+
+  final downloadService = Get.find<DownloadService>();
+  final before =
+      downloadService.downloadList.length + downloadService.waitDownloadQueue.length;
+
+  var submittedVideos = 0;
+  var submittedPages = 0;
+  var failed = 0;
+
+  SmartDialog.showLoading(msg: '正在解析 0/${videos.length}');
+  for (var i = 0; i < videos.length; i++) {
+    SmartDialog.showLoading(msg: '正在解析 ${i + 1}/${videos.length}');
+    final item = videos[i];
+    try {
+      final res = await VideoHttp.videoIntro(bvid: item.bvid!);
+      if (res case Success(:final response)) {
+        final pages = response.pages;
+        if (pages == null || pages.isEmpty) {
+          failed++;
+          continue;
+        }
+        submittedVideos++;
+        for (var index = 0; index < pages.length; index++) {
+          downloadService.downloadVideo(
+            index: index,
+            page: pages[index],
+            videoDetail: response,
+            videoQuality: quality,
+          );
+          submittedPages++;
+        }
+      } else {
+        failed++;
+      }
+    } catch (_) {
+      failed++;
+    }
+  }
+  SmartDialog.dismiss();
+
+  // _createDownload 是异步落盘的，等它把队列写进去再统计实际新增
+  await Future.delayed(const Duration(milliseconds: 600));
+  final after =
+      downloadService.downloadList.length + downloadService.waitDownloadQueue.length;
+  final added = after - before;
+
+  final buffer = StringBuffer('已加入下载队列：$submittedVideos 个视频');
+  if (submittedPages > submittedVideos) {
+    buffer.write('（共 $submittedPages 个分P）');
+  }
+  if (added < submittedPages) {
+    buffer.write('，${submittedPages - added} 个已在列表中跳过');
+  }
+  if (failed > 0) {
+    buffer.write('，$failed 个解析失败');
+  }
+  if (skipped > 0) {
+    buffer.write('，跳过 $skipped 个非视频条目');
+  }
+  SmartDialog.showToast(buffer.toString());
+}
+
+Future<VideoQuality?> _pickQuality(BuildContext context, int count) {
+  return showDialog<VideoQuality>(
+    context: context,
+    builder: (context) => SimpleDialog(
+      clipBehavior: Clip.hardEdge,
+      contentPadding: const EdgeInsets.symmetric(vertical: 12),
+      children: [
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 4, 16, 10),
+          child: Text(
+            '选择画质（共 $count 个视频，按分P逐个加入）',
+            style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w500),
+          ),
+        ),
+        for (final quality in VideoQuality.values)
+          DialogOption(
+            onPressed: () => Navigator.of(context).pop(quality),
+            child: Row(
+              children: [
+                Expanded(
+                  child: Text(
+                    quality.desc,
+                    style: const TextStyle(fontSize: 14),
+                  ),
+                ),
+                if (quality.code == Pref.defaultVideoQa)
+                  Text(
+                    '默认',
+                    style: TextStyle(
+                      fontSize: 12,
+                      color: ColorScheme.of(context).outline,
+                    ),
+                  ),
+              ],
+            ),
+          ),
+      ],
+    ),
+  );
+}
